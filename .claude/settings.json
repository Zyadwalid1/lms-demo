{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./backend/.env)",
      "Read(./backend/.env.*)",
      "Read(./frontend/.env)",
      "Read(./frontend/.env.*)",
      "Edit(./backend/.env)",
      "Edit(./frontend/.env)",
      "Bash(git push --force:*)"
    ],
    "ask": [
      "Bash(python manage.py migrate:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(pip install:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python .claude/hooks/guard.py" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "python .claude/hooks/lint_python.py" }]
      }
    ]
  }
}
